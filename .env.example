# Copy to .env and fill in. Never commit .env.
GNANI_API_KEY=your_gnani_key_here

# --- optional: language-model review (hybrid mode). Leave blank to run rules only. ---
# Self-hosted Gnani Evon served with vLLM or SGLang (OpenAI-compatible):
#   vllm serve gnani/gnani-evon-v3.3-30B-A3B --served-model-name gnani-evon-v3.3 --max-model-len 32768
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=none
# LLM_MODEL=gnani-evon-v3.3
# LLM_TIMEOUT=10
# LLM_DISABLE_THINKING=1

# --- optional: force a Timbre model (default: try v3.0, fall back to v2.5) ---
# TIMBRE_MODEL=timbre-v2.5
